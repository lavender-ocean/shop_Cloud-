<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.product.mapper.BrandMapper">
    <select id="selectAll" resultType="com.shop.product.entity.Brand">
        SELECT id, name, logo, description, status FROM brand
        WHERE deleted = 0 AND status = 1 ORDER BY id ASC
    </select>
</mapper>